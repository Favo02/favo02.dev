---
import BaseLayout from "../layouts/BaseLayout.astro"
import PageHeader from "../components/PageHeader.astro"

// All timeline entries in a single flat list, sorted newest-first
// Set compact: true for secondary items (e.g. certificates, minor events)
const timeline = [
  {
    type: "experience" as const,
    period: "Feb 2024 — May 2024",
    title: "Programming Tutor",
    org: "Università degli Studi di Milano",
    description: 'Tutor for "Programmazione I" course (in Golang)',
    link: "https://mameli.docenti.di.unimi.it/pls-tutoring/wiki/WikiStart",
    result: null,
    compact: false,
  },
  {
    type: "education" as const,
    period: "2021 — present",
    title: "Università degli Studi di Milano",
    org: "Milan",
    description: "Bachelor in computer science (triennale informatica)",
    link: "https://www.unimi.it/en/education/computer-science",
    result: null,
    compact: false,
  },
  {
    type: "event" as const,
    period: "2022",
    title: "PG Nationals BeSerious Spring",
    org: "Rainbow Six Siege",
    description: "Italian second division tournament with P11",
    link: "https://liquipedia.net/rainbowsix/PG_Nationals/2022/BeSerious/Spring",
    result: "2nd place",
    compact: false,
  },
  {
    type: "certificate" as const,
    period: "2022",
    title: "FullStackOpen",
    org: "University of Helsinki",
    description: "Modern Full Stack Web Development",
    link: "https://fullstackopen.com/en",
    result: null,
    compact: true,
  },
  {
    type: "education" as const,
    period: "2016 — 2021",
    title: "ITIS Cannizzaro",
    org: "Rho",
    description: "High school in computer science (ITIS indirizzo informatica)",
    link: "https://www.itiscannizzaro.edu.it/pagine/-informatica",
    result: null,
    compact: false,
  },
  {
    type: "event" as const,
    period: "2018",
    title: "PigParty BedWars League",
    org: "Minecraft CWBW",
    description: "4v4 Italian championship with Rebirth",
    link: null,
    result: "Italian Champion",
    compact: false,
  },
  {
    type: "certificate" as const,
    period: "2021",
    title: "Elements of AI",
    org: "MinnaLearn & Univ. of Helsinki",
    description: "Artificial intelligence introductory course",
    link: "https://www.elementsofai.com",
    result: null,
    compact: true,
  },
  {
    type: "certificate" as const,
    period: "2021",
    title: "English B2 First",
    org: "Cambridge English",
    description: "Cambridge English B2 qualification",
    link: "https://www.cambridgeenglish.org/exams-and-tests/first",
    result: null,
    compact: true,
  },
]

// Publications kept separate — hidden when empty
const publications: {
  year: string
  title: string
  venue: string
  description: string
  link: string | null
}[] = [
  // {
  //   year: '2025',
  //   title: 'My Bachelor Thesis',
  //   venue: 'Università degli Studi di Milano',
  //   description: 'Short description of what it covers.',
  //   link: null,
  // },
]

const typeLabel: Record<(typeof timeline)[number]["type"], string> = {
  experience: "experience",
  education: "education",
  certificate: "certificate",
  event: "event",
}

const calculateAge = (birthday: Date) => {
  const ageDifMs = Date.now() - birthday.getTime()
  const ageDate = new Date(ageDifMs)
  return Math.abs(ageDate.getUTCFullYear() - 1970)
}

const myAge = calculateAge(new Date("August 25, 2002"))
---

<BaseLayout
  title="About"
  description="About Luca Favini — biography, education, experience, and more."
>
  <div class="about-page">
    <PageHeader title="About" subtitle="Who is Luca?" />

    <!-- ── Intro: photo floated left, bio wraps around it ── -->
    <section class="intro-section">
      <div class="photo-wrap">
        <img
          src="/propic.webp"
          alt="Luca Favini hiking on a mountain ridge"
          class="propic"
          loading="eager"
        />
      </div>

      <div class="intro-text">
        <div class="intro-bio">
          <p>
            Hello, I am <strong>Luca Favini</strong>, but my friends call me <strong
              >Favo</strong
            >. I am a {myAge}-year-old guy living <em>(near)</em>
            <strong>Milan, Italy</strong>.
          </p>
          <p>
            My educational background is entirely centered around <strong
              >computer science</strong
            >, which I am currently studying at <strong
              >Università degli studi di Milano</strong
            >. For more details about my <strong>interests</strong>, <strong
              >notable projects</strong
            > and <strong>current focuses</strong> check out my <a
              href="https://github.com/Favo02"
              target="_blank"
              rel="noopener noreferrer">GitHub README</a
            >. I update it quite <em>frequently</em>, much more than this
            website!
          </p>
          <p>
            I also engage in activities unrelated to computers. I have a strong
            passion for playing basically <strong>any sport</strong>,
            particularly <strong>football</strong>
            <em
              ><span class="opacity-70">(the real one, <del>soccer</del>)</span
              ></em
            >, which I played for many years in my hometown team. However, I
            must admit that my <strong>competitive nature</strong> and desire for
            <strong>precision</strong> come into play: whether it's a casual or competitive
            game, I always strive to achieve victory and to excel. Another thing I
            really enjoy is pushing my physical limits through activities such as
            running, cycling or hiking <em
              ><span class="opacity-70">(mountain &gt; seaside)</span></em
            >.
          </p>
          <p>
            Returning to computers: I consider myself a decent <strong
              >competitive gamer</strong
            >, competing under the alias of <em><strong>imprudenza</strong></em>
            <a
              href="https://linktr.ee/imprudenza"
              target="_blank"
              rel="noopener noreferrer"
              ><em
                ><span class="opacity-70">(imprudenza's socials linktree)</span
                ></em
              ></a
            >. In the past, I competed in <em>Minecraft</em>
            <span title="ClanWar BedWars, 4v4 on PigParty or GommeHD">CWBW</span
            >, becoming <span title="PigParty BedWars league, 4v4 on PigParty"
              ><em>2018 Italian Champion</em></span
            > with <em><span class="opacity-70">Rebirth</span></em>. In recent
            years, I transitioned to <em>Rainbow Six Siege</em>, where I secured
            second place in the <a
              href="https://liquipedia.net/rainbowsix/PG_Nationals/2022/BeSerious/Spring"
              target="_blank"
              rel="noopener noreferrer"
              title="BeSerious Spring 2022"
              ><em>2022 Italian Second Division</em></a
            > with <em><span class="opacity-70">P11</span></em>. Due to time
            constraints, my involvement in competitive gaming has reduced. <del
              ><span class="opacity-70"
                >However, I still occasionally participate in competitive
                tournaments for fun.</span
              ></del
            >
          </p>
          <p>
            <em>Last but not least:</em> you can recognize me IRL by the <a
              href="https://upload.wikimedia.org/wikipedia/en/2/26/Papasmurf1.jpg"
              target="_blank"
              rel="noopener noreferrer">smurf</a
            > attached to my backpack.
          </p>
          <p class="bio-footnote mono-sm">
            Contact &amp; socials in the footer. CV and certificates available
            on request.
          </p>
        </div>
      </div>
      <!-- clearfix so section stretches past the float -->
      <div style="clear:both"></div>
    </section>

    <!-- ── Unified timeline ── -->
    <section class="timeline-section">
      <h2 class="section-label mono">Background</h2>
      <ul class="timeline-list">
        {
          timeline.map((item) => (
            <li class:list={["tl-item", { "tl-item--compact": item.compact }]}>
              <span class="tl-period mono-sm">{item.period}</span>
              <div class="tl-body">
                <div class="tl-top">
                  {item.link ? (
                    <a
                      href={item.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="tl-title"
                    >
                      {item.title}
                    </a>
                  ) : (
                    <span class="tl-title">{item.title}</span>
                  )}
                  <div class="tl-badges">
                    {item.result && (
                      <span class="tl-result">{item.result}</span>
                    )}
                    <span class:list={["tl-tag", `tl-tag--${item.type}`]}>
                      {typeLabel[item.type]}
                    </span>
                  </div>
                </div>
                <p class="tl-meta mono-sm">{item.org}</p>
                {!item.compact && item.description && (
                  <p class="tl-desc">{item.description}</p>
                )}
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- ── Publications (shown only when non-empty) ── -->
    {
      publications.length > 0 && (
        <section class="timeline-section">
          <h2 class="section-label mono">Publications</h2>
          <ul class="timeline-list">
            {publications.map((item) => (
              <li class="tl-item">
                <span class="tl-period mono-sm">{item.year}</span>
                <div class="tl-body">
                  <div class="tl-top">
                    {item.link ? (
                      <a
                        href={item.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="tl-title"
                      >
                        {item.title}
                      </a>
                    ) : (
                      <span class="tl-title">{item.title}</span>
                    )}
                    <span class="tl-tag tl-tag--publication">publication</span>
                  </div>
                  <p class="tl-meta mono-sm">{item.venue}</p>
                  {item.description && (
                    <p class="tl-desc">{item.description}</p>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .about-page {
    padding-top: var(--space-2xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  /* ── Intro ── */
  .intro-section {
    margin-bottom: var(--space-3xl);
    /* float layout: photo floats left, text wraps around it */
  }

  .photo-wrap {
    float: left;
    width: 220px;
    margin-right: var(--space-2xl);
    margin-bottom: var(--space-lg);
    shape-outside: margin-box;
  }

  .propic {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: center 20%;
    border-radius: 4px;
    filter: grayscale(15%);
    transition: filter var(--transition-base);
  }

  .propic:hover {
    filter: grayscale(0%);
  }

  .intro-text {
    /* nothing needed — flows around the float */
  }

  .intro-name {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--text);
    margin-bottom: var(--space-xl);
    font-weight: 700;
    font-style: normal;
  }

  .intro-name em {
    font-style: italic;
    font-weight: 400;
    color: var(--text-muted);
  }

  /* ── Bio prose ── */
  .intro-bio p {
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    color: var(--text-muted);
    margin-bottom: var(--space-md);
  }

  .intro-bio strong {
    color: var(--text);
    font-weight: 600;
  }

  .intro-bio a {
    color: var(--text-muted);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 3px;
    transition:
      color var(--transition-fast),
      text-decoration-color var(--transition-fast);
  }

  .intro-bio a:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  .opacity-70 {
    opacity: 0.7;
  }

  .bio-footnote {
    margin-top: var(--space-xl);
    padding-top: var(--space-md);
    border-top: 1px solid var(--border-subtle);
    color: var(--text-faint) !important;
    font-size: var(--text-xs) !important;
    margin-bottom: 0;
  }

  /* ── Section label ── */
  .section-label {
    font-size: var(--text-xs) !important;
    font-family: var(--font-mono) !important;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--text-faint);
    margin-bottom: var(--space-lg);
    font-weight: 500;
  }

  /* ── Unified timeline list ── */
  .timeline-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border-subtle);
  }

  .tl-item {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: var(--space-lg);
    padding: var(--space-lg) 0;
    border-bottom: 1px solid var(--border-subtle);
    border-left: 2px solid transparent;
    padding-left: var(--space-sm);
    transition:
      border-left-color var(--transition-fast),
      background-color var(--transition-fast);
  }

  /* Compact variant — secondary entries (certificates, minor events) */
  .tl-item--compact {
    padding: var(--space-sm) 0;
    padding-left: var(--space-sm);
    grid-template-columns: 100px 1fr;
    gap: var(--space-md);
  }

  .tl-item--compact .tl-period {
    font-size: 0.7rem;
  }

  .tl-item--compact .tl-title {
    font-size: var(--text-sm);
  }

  .tl-item--compact .tl-meta {
    font-size: 0.7rem;
  }

  .tl-item:hover {
    border-left-color: var(--border);
    background: color-mix(in srgb, var(--bg-surface) 50%, transparent);
  }

  .tl-period {
    padding-top: 3px;
    white-space: nowrap;
    color: var(--text-faint);
  }

  .tl-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .tl-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .tl-title {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 400;
    font-style: italic;
    color: var(--text);
    text-decoration: none;
    line-height: var(--leading-snug);
    transition: color var(--transition-fast);
  }

  a.tl-title:hover {
    color: var(--accent);
  }

  .tl-badges {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-shrink: 0;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .tl-result {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--accent);
    white-space: nowrap;
  }

  /* Type tags */
  .tl-tag {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    padding: 0.15em 0.55em;
    border-radius: 3px;
    border: 1px solid;
    white-space: nowrap;
  }

  .tl-tag--experience {
    color: var(--tag-personal);
    border-color: var(--tag-personal);
  }

  .tl-tag--education {
    color: var(--tag-academic);
    border-color: var(--tag-academic);
  }

  .tl-tag--certificate {
    color: var(--text-faint);
    border-color: var(--border);
  }

  .tl-tag--event {
    color: var(--accent);
    border-color: var(--accent);
  }

  .tl-tag--publication {
    color: var(--tag-academic);
    border-color: var(--tag-academic);
  }

  .tl-meta {
    color: var(--text-faint);
    margin: 0;
  }

  .tl-desc {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin: 0;
    line-height: var(--leading-normal);
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .photo-wrap {
      float: none;
      width: 100%;
      margin-right: 0;
      margin-bottom: var(--space-xl);
    }

    .propic {
      max-height: 320px;
      object-position: center 25%;
    }

    .intro-name {
      font-size: clamp(2.5rem, 10vw, 4rem);
    }

    .tl-item {
      grid-template-columns: 1fr;
      gap: var(--space-xs);
    }

    .tl-period {
      padding-top: 0;
    }

    .tl-top {
      flex-direction: column;
      align-items: flex-start;
    }

    .tl-badges {
      justify-content: flex-start;
    }
  }
</style>
