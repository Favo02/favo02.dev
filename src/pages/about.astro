---
import BaseLayout from '../layouts/BaseLayout.astro';

const experience = [
  {
    period: 'Feb 2024 — May 2024',
    title: 'Programming Tutor',
    org: 'Università degli Studi di Milano',
    description: 'Tutor for "Programmazione I" course (in Golang)',
    link: 'https://mameli.docenti.di.unimi.it/pls-tutoring/wiki/WikiStart',
  },
];

const education = [
  {
    period: '2021 — present',
    title: 'Università degli Studi di Milano',
    org: 'Milan',
    description: 'Bachelor in computer science (triennale informatica)',
    link: 'https://www.unimi.it/en/education/computer-science',
  },
  {
    period: '2016 — 2021',
    title: 'ITIS Cannizzaro',
    org: 'Rho',
    description: 'High school in computer science (ITIS indirizzo informatica)',
    link: 'https://www.itiscannizzaro.edu.it/pagine/-informatica',
  },
];

const certificates = [
  {
    year: '2022',
    title: 'FullStackOpen',
    description: 'University of Helsinki — modern Full Stack Web Development',
    link: 'https://fullstackopen.com/en',
  },
  {
    year: '2021',
    title: 'Elements of AI',
    description: 'MinnaLearn & University of Helsinki — artificial intelligence',
    link: 'https://www.elementsofai.com',
  },
  {
    year: '2021',
    title: 'English B2 First',
    description: 'Cambridge English B2 qualification',
    link: 'https://www.cambridgeenglish.org/exams-and-tests/first',
  },
];

// Events: hackathons, awards, competitions — add entries here
const events = [
  {
    year: '2022',
    title: 'PG Nationals BeSerious Spring',
    result: '2nd place',
    description: 'Italian Rainbow Six Siege second division tournament',
    link: 'https://liquipedia.net/rainbowsix/PG_Nationals/2022/BeSerious/Spring',
  },
  {
    year: '2018',
    title: 'PigParty BedWars League',
    result: 'Italian Champion',
    description: 'Minecraft ClanWar BedWars 4v4 Italian championship with Rebirth',
    link: null,
  },
];

// Publications — add your papers, theses, or articles here
const publications: {
  year: string;
  title: string;
  venue: string;
  description: string;
  link: string | null;
}[] = [
  // Example entry (remove or replace when you have real ones):
  // {
  //   year: '2025',
  //   title: 'My Bachelor Thesis',
  //   venue: 'Università degli Studi di Milano',
  //   description: 'Short description of what it covers.',
  //   link: null,
  // },
];

const calculateAge = (birthday: Date) => {
  const ageDifMs = Date.now() - birthday.getTime();
  const ageDate = new Date(ageDifMs);
  return Math.abs(ageDate.getUTCFullYear() - 1970);
};

const myAge = calculateAge(new Date('August 25, 2002'));
---

<BaseLayout title="About" description="About Luca Favini — biography, education, experience, and more.">
  <div class="about-page">

    <!-- ── Intro: photo + bio side by side ── -->
    <section class="intro-section">
      <div class="intro-photo-col">
        <div class="photo-wrap">
          <img
            src="/propic.webp"
            alt="Luca Favini hiking on a mountain ridge"
            class="propic"
            loading="eager"
          />
        </div>
      </div>

      <div class="intro-text-col">
        <h1 class="intro-name">Luca<br /><em>Favini</em></h1>
        <div class="intro-bio">
          <p>
            {myAge} years old, based <em>(near)</em> <strong>Milan, Italy</strong>.
            My friends call me <strong>Favo</strong>.
          </p>
          <p>
            I study <strong>computer science</strong> at Università degli Studi di Milano
            and spend a lot of time writing code, mostly in the open.
            My <a href="https://github.com/Favo02" target="_blank" rel="noopener noreferrer">GitHub README</a>
            tracks my current interests more accurately than this page.
          </p>
          <p>
            Outside computers: football <em>(the real one)</em>, running, cycling, hiking —
            preferably uphill. I compete under the alias
            <a href="https://linktr.ee/imprudenza" target="_blank" rel="noopener noreferrer"><em>imprudenza</em></a>.
          </p>
          <p class="bio-footnote mono-sm">
            Contact &amp; socials in the footer of every page.
            CV and certificates available on request.
          </p>
        </div>
      </div>
    </section>

    <!-- ── Experience ── -->
    <section class="cards-section">
      <h2 class="section-label mono">Experience</h2>
      <div class="cards-grid">
        {experience.map((item) => (
          <a href={item.link} target="_blank" rel="noopener noreferrer" class="card">
            <div class="card-top">
              <span class="card-period mono-sm">{item.period}</span>
              <span class="card-org mono-sm">{item.org}</span>
            </div>
            <p class="card-title">{item.title}</p>
            <p class="card-desc">{item.description}</p>
          </a>
        ))}
      </div>
    </section>

    <!-- ── Education ── -->
    <section class="cards-section">
      <h2 class="section-label mono">Education</h2>
      <div class="cards-grid">
        {education.map((item) => (
          <a href={item.link} target="_blank" rel="noopener noreferrer" class="card">
            <div class="card-top">
              <span class="card-period mono-sm">{item.period}</span>
              <span class="card-org mono-sm">{item.org}</span>
            </div>
            <p class="card-title">{item.title}</p>
            <p class="card-desc">{item.description}</p>
          </a>
        ))}
      </div>
    </section>

    <!-- ── Events ── -->
    {events.length > 0 && (
      <section class="cards-section">
        <h2 class="section-label mono">Events &amp; Awards</h2>
        <div class="cards-grid">
          {events.map((item) => (
            item.link
              ? (
                <a href={item.link} target="_blank" rel="noopener noreferrer" class="card card--event">
                  <div class="card-top">
                    <span class="card-period mono-sm">{item.year}</span>
                    <span class="event-result">{item.result}</span>
                  </div>
                  <p class="card-title">{item.title}</p>
                  <p class="card-desc">{item.description}</p>
                </a>
              )
              : (
                <div class="card card--event">
                  <div class="card-top">
                    <span class="card-period mono-sm">{item.year}</span>
                    <span class="event-result">{item.result}</span>
                  </div>
                  <p class="card-title">{item.title}</p>
                  <p class="card-desc">{item.description}</p>
                </div>
              )
          ))}
        </div>
      </section>
    )}

    <!-- ── Publications ── -->
    {publications.length > 0 && (
      <section class="cards-section">
        <h2 class="section-label mono">Publications</h2>
        <div class="cards-grid">
          {publications.map((item) => (
            item.link
              ? (
                <a href={item.link} target="_blank" rel="noopener noreferrer" class="card card--pub">
                  <div class="card-top">
                    <span class="card-period mono-sm">{item.year}</span>
                    <span class="card-org mono-sm">{item.venue}</span>
                  </div>
                  <p class="card-title">{item.title}</p>
                  <p class="card-desc">{item.description}</p>
                </a>
              )
              : (
                <div class="card card--pub">
                  <div class="card-top">
                    <span class="card-period mono-sm">{item.year}</span>
                    <span class="card-org mono-sm">{item.venue}</span>
                  </div>
                  <p class="card-title">{item.title}</p>
                  <p class="card-desc">{item.description}</p>
                </div>
              )
          ))}
        </div>
      </section>
    )}

    <!-- ── Certificates ── -->
    <section class="cards-section">
      <h2 class="section-label mono">Certificates</h2>
      <div class="cards-grid cards-grid--3">
        {certificates.map((item) => (
          <a href={item.link} target="_blank" rel="noopener noreferrer" class="card">
            <span class="card-period mono-sm">{item.year}</span>
            <p class="card-title">{item.title}</p>
            <p class="card-desc">{item.description}</p>
          </a>
        ))}
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .about-page {
    padding-top: var(--space-2xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-4xl);
  }

  /* ── Intro ── */
  .intro-section {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: var(--space-3xl);
    align-items: start;
  }

  .photo-wrap {
    position: sticky;
    top: var(--space-xl);
  }

  .propic {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: center 20%;
    border-radius: 4px;
    filter: grayscale(15%);
    transition: filter var(--transition-base);
  }

  .propic:hover {
    filter: grayscale(0%);
  }

  .intro-name {
    font-family: var(--font-display);
    font-size: clamp(3rem, 6vw, 5rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--text);
    margin-bottom: var(--space-xl);
    font-style: normal;
  }

  .intro-name em {
    font-style: italic;
    font-weight: 400;
    color: var(--text-muted);
  }

  .intro-bio {
    max-width: 520px;
  }

  .intro-bio p {
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    color: var(--text-muted);
    margin-bottom: var(--space-md);
  }

  .intro-bio strong {
    color: var(--text);
    font-weight: 600;
  }

  .intro-bio a {
    color: var(--text-muted);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 3px;
    transition: color var(--transition-fast), text-decoration-color var(--transition-fast);
  }

  .intro-bio a:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  .bio-footnote {
    margin-top: var(--space-xl);
    padding-top: var(--space-md);
    border-top: 1px solid var(--border-subtle);
    color: var(--text-faint) !important;
    font-size: var(--text-xs) !important;
  }

  /* ── Section label ── */
  .section-label {
    font-size: var(--text-xs) !important;
    font-family: var(--font-mono) !important;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--text-faint);
    margin-bottom: var(--space-lg);
    font-weight: 500;
  }

  .cards-section {
    /* gap handled by about-page flex column */
  }

  /* ── Cards grid ── */
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-md);
  }

  .cards-grid--3 {
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  }

  .card {
    display: block;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: var(--space-lg);
    text-decoration: none;
    color: var(--text);
    transition:
      border-color var(--transition-fast),
      background var(--transition-fast),
      transform var(--transition-fast);
    cursor: pointer;
  }

  a.card:hover {
    border-color: var(--text-faint);
    background: var(--bg-elevated);
    transform: translateY(-1px);
  }

  div.card {
    cursor: default;
  }

  .card-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .card-period {
    flex-shrink: 0;
  }

  .card-org {
    text-align: right;
    color: var(--text-faint);
  }

  .card-title {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 400;
    font-style: italic;
    color: var(--text);
    margin-bottom: var(--space-xs);
    line-height: var(--leading-snug);
  }

  .card-desc {
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: var(--leading-normal);
    margin-bottom: 0;
  }

  /* ── Event result badge ── */
  .event-result {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .intro-section {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }

    .photo-wrap {
      position: static;
    }

    .propic {
      max-height: 360px;
      width: 100%;
    }

    .intro-name {
      font-size: clamp(2.5rem, 10vw, 4rem);
    }
  }

  @media (max-width: 480px) {
    .cards-grid,
    .cards-grid--3 {
      grid-template-columns: 1fr;
    }
  }
</style>
