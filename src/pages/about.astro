---
import BaseLayout from '../layouts/BaseLayout.astro';

// Education & experience data
const experience = [
  {
    period: 'Feb 2024 — May 2024',
    title: 'Programming Tutor',
    org: 'Università degli Studi di Milano',
    description: 'Tutor for "Programmazione I" course (in Golang)',
    link: 'https://mameli.docenti.di.unimi.it/pls-tutoring/wiki/WikiStart',
  },
];

const education = [
  {
    period: '2021 — present',
    title: 'Università degli Studi di Milano',
    org: 'Milan',
    description: 'Bachelor in computer science (triennale informatica)',
    link: 'https://www.unimi.it/en/education/computer-science',
  },
  {
    period: '2016 — 2021',
    title: 'ITIS Cannizzaro',
    org: 'Rho',
    description: 'High school in computer science (ITIS indirizzo informatica)',
    link: 'https://www.itiscannizzaro.edu.it/pagine/-informatica',
  },
];

const certificates = [
  {
    year: '2022',
    title: 'FullStackOpen course',
    description: 'University of Helsinki modern Full Stack Web Development course',
    link: 'https://fullstackopen.com/en',
  },
  {
    year: '2021',
    title: 'Elements of AI course',
    description: 'MinnaLearn and University of Helsinki artificial intelligence course',
    link: 'https://www.elementsofai.com',
  },
  {
    year: '2021',
    title: 'English B2 First qualification',
    description: 'Cambridge English B2 qualification',
    link: 'https://www.cambridgeenglish.org/exams-and-tests/first',
  },
];

const calculateAge = (birthday: Date) => {
  const ageDifMs = Date.now() - birthday.getTime();
  const ageDate = new Date(ageDifMs);
  return Math.abs(ageDate.getUTCFullYear() - 1970);
};

const myAge = calculateAge(new Date("August 25, 2002"));
---

<BaseLayout title="About" description="About Luca Favini — biography, education, experience, and certificates.">
  <div class="about-page">
    <header class="page-header">
      <h1>About</h1>
    </header>

    <section class="bio prose">
      <p>
        Hello, I am <strong>Luca Favini</strong>, but my friends call me <strong>Favo</strong>. I am a {myAge}-year-old guy living <em>(near)</em> <strong>Milan, Italy</strong>.
      </p>
      <p>
        My educational background is entirely centered around <strong>computer science</strong>, which I am currently studying at <strong>Università degli studi di Milano</strong>. For more details about my <strong>interests</strong>, <strong>notable projects</strong> and <strong>current focuses</strong> check out my <a href="https://github.com/Favo02" target="_blank" rel="noopener noreferrer">GitHub README</a>. I update it quite <em>frequently</em>, much more than this website!
      </p>
      <p>
        I also engage in activities unrelated to computers. I have a strong passion for playing basically <strong>any sport</strong>, particularly <strong>football</strong> <em><span class="opacity-70">(the real one, <del>soccer</del>)</span></em>, which I played for many years in my hometown team. However, I must admit that my <strong>competitive nature</strong> and desire for <strong>precision</strong> come into play: whether it's a casual or competitive game, I always strive to achieve victory and to excel. Another thing I really enjoy is pushing my physical limits through activities such as running, cycling or hiking <em><span class="opacity-70">(mountain &gt; seaside)</span></em>.
      </p>
      <p>
        Returning to computers: I consider myself a decent <strong>competitive gamer</strong>, competing under the alias of <em><strong>imprudenza</strong></em> <a href="https://linktr.ee/imprudenza" target="_blank" rel="noopener noreferrer"><em><span class="opacity-70">(imprudenza's socials linktree)</span></em></a>. In the past, I competed in <em>Minecraft</em> <span title="ClanWar BedWars, 4v4 on PigParty or GommeHD">CWBW</span>, becoming <span title="PigParty BedWars league, 4v4 on PigParty"><em>2018 Italian Champion</em></span> with <em><span class="opacity-70">Rebirth</span></em>. In recent years, I transitioned to <em>Rainbow Six Siege</em>, where I secured second place in the <a href="https://liquipedia.net/rainbowsix/PG_Nationals/2022/BeSerious/Spring" target="_blank" rel="noopener noreferrer" title="BeSerious Spring 2022"><em>2022 Italian Second Division</em></a> with <em><span class="opacity-70">P11</span></em>. Due to time constraints, my involvement in competitive gaming has reduced. <del><span class="opacity-70">However, I still occasionally participate in competitive tournaments for fun.</span></del>
      </p>
      <p>
        <em>Last but not least:</em> you can recognize me IRL by the <a href="https://upload.wikimedia.org/wikipedia/en/2/26/Papasmurf1.jpg" target="_blank" rel="noopener noreferrer">smurf</a> attached to my backpack.
      </p>
      
      <p class="contact-note italic">
        You can find my <strong>contact information</strong> and <strong>socials</strong> in the footer of every page.
      </p>
    </section>

    <section class="timeline-section">
      <h2 class="section-title mono">Experience</h2>
      <div class="timeline">
        {experience.map((item) => (
          <div class="timeline-item">
            <span class="timeline-period mono-sm">{item.period}</span>
            <div class="timeline-content">
              <h3>
                <a href={item.link} target="_blank" rel="noopener noreferrer">{item.title}</a>
              </h3>
              <span class="timeline-org">{item.org}</span>
              <p class="timeline-desc">{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="timeline-section">
      <h2 class="section-title mono">Education</h2>
      <div class="timeline">
        {education.map((item) => (
          <div class="timeline-item">
            <span class="timeline-period mono-sm">{item.period}</span>
            <div class="timeline-content">
              <h3>
                <a href={item.link} target="_blank" rel="noopener noreferrer">{item.title}</a>
              </h3>
              <span class="timeline-org">{item.org}</span>
              <p class="timeline-desc">{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="timeline-section">
      <h2 class="section-title mono">Certificates</h2>
      <div class="timeline">
        {certificates.map((item) => (
          <div class="timeline-item">
            <span class="timeline-period mono-sm">{item.year}</span>
            <div class="timeline-content">
              <h3>
                <a href={item.link} target="_blank" rel="noopener noreferrer">{item.title}</a>
              </h3>
              <p class="timeline-desc">{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <footer class="about-footer">
      <p class="contact-note italic">
        My <strong>Curriculum Vitae</strong> and <strong>Certificates</strong> are available upon request. Contact me.
      </p>
    </footer>
  </div>
</BaseLayout>

<style>
  .about-page {
    padding-top: var(--space-2xl);
  }

  .page-header {
    margin-bottom: var(--space-2xl);
  }

  .page-header h1 {
    font-size: var(--text-3xl);
    font-weight: 300;
  }

  .bio {
    max-width: var(--max-width-prose);
    margin-bottom: var(--space-3xl);
    font-size: var(--text-base);
    line-height: var(--leading-normal);
  }

  .bio p {
    margin-bottom: var(--space-md);
  }

  .bio strong {
    font-weight: 600;
  }

  .opacity-70 {
    opacity: 0.7;
  }

  .contact-note {
    text-align: center;
    color: var(--text-muted);
    margin-top: var(--space-xl);
    font-weight: 300;
  }
  
  .contact-note strong {
    font-weight: 600;
  }

  /* Timeline sections */
  .timeline-section {
    margin-bottom: var(--space-3xl);
  }

  .section-title {
    font-size: var(--text-xs) !important;
    font-family: var(--font-mono) !important;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--text-muted);
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--border);
    font-weight: 500;
  }

  .timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: var(--space-lg);
  }

  .timeline-period {
    padding-top: 2px;
    white-space: nowrap;
  }

  .timeline-content h3 {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 400;
    margin-bottom: var(--space-xs);
  }

  .timeline-content h3 a {
    color: var(--text);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .timeline-content h3 a:hover {
    color: var(--accent);
  }

  .timeline-org {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-faint);
    letter-spacing: var(--tracking-wide);
  }

  .timeline-desc {
    color: var(--text-muted);
    font-size: var(--text-sm);
    margin-top: var(--space-xs);
    margin-bottom: 0;
  }

  .about-footer {
    padding-top: var(--space-xl);
    border-top: 1px solid var(--border);
  }

  @media (max-width: 640px) {
    .timeline-item {
      grid-template-columns: 1fr;
      gap: var(--space-xs);
    }
  }
</style>
