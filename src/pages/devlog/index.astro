---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

const entries = (await getCollection('devlog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Pre-render all entries
const renderedEntries = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  })
);
---

<BaseLayout title="Devlog" description="Development log — short entries about what Luca Favini is building, learning, and experimenting with.">
  <div class="devlog-page">
    <header class="page-header">
      <h1>Devlog</h1>
      <p class="page-description">
        Short entries about what I'm building, learning, and experimenting with.
      </p>
    </header>

    {entries.length === 0 ? (
      <p class="empty-state">No entries yet.</p>
    ) : (
      <div class="devlog-entries">
        {renderedEntries.map(({ entry, Content }) => (
            <article class="devlog-entry">
              <div class="devlog-header">
                <time datetime={entry.data.date.toISOString()} class="mono-sm">
                  {entry.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
                <h2 class="devlog-title">{entry.data.title}</h2>
              </div>
              <div class="devlog-body prose">
                <Content />
              </div>
            </article>
        ))}
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .devlog-page {
    padding-top: var(--space-2xl);
  }

  .page-header {
    margin-bottom: var(--space-2xl);
  }

  .page-header h1 {
    font-size: var(--text-3xl);
    font-weight: 300;
    margin-bottom: var(--space-md);
  }

  .page-description {
    color: var(--text-muted);
    max-width: var(--max-width-prose);
  }

  .empty-state {
    color: var(--text-faint);
    font-style: italic;
  }

  .devlog-entries {
    display: flex;
    flex-direction: column;
  }

  .devlog-entry {
    padding: var(--space-xl) 0;
    border-bottom: 1px solid var(--border);
    max-width: var(--max-width-prose);
  }

  .devlog-entry:first-child {
    border-top: 1px solid var(--border);
  }

  .devlog-header {
    margin-bottom: var(--space-md);
  }

  .devlog-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 400;
    margin-top: var(--space-xs);
  }

  .devlog-body {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .devlog-body :global(p) {
    margin-bottom: var(--space-sm);
  }

  .devlog-body :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
