---
---

<footer class="site-footer">
  <!-- Top rule + big name -->
  <div class="footer-top">
    <div class="footer-name-wrap container-wide">
      <p class="footer-eyebrow mono-sm">based in Milan · open to opportunities</p>
      <p class="footer-name">Luca<br />Favini</p>
    </div>
  </div>

  <!-- Scrolling marquee strip -->
  <div class="marquee-strip" aria-hidden="true">
    <div class="marquee-track">
      {Array.from({ length: 4 }).map(() => (
        <span class="marquee-set">
          <a href="https://github.com/Favo02" target="_blank" rel="noopener noreferrer" class="marquee-link">GitHub</a>
          <span class="marquee-sep">·</span>
          <a href="https://linkedin.com/in/lucafavini" target="_blank" rel="noopener noreferrer" class="marquee-link">LinkedIn</a>
          <span class="marquee-sep">·</span>
          <span class="marquee-link marquee-email">luca.favini.02 AT gmail.com</span>
          <span class="marquee-sep">·</span>
          <a href="/projects" class="marquee-link">Projects</a>
          <span class="marquee-sep">·</span>
          <a href="/now" class="marquee-link">Now</a>
          <span class="marquee-sep">·</span>
          <a href="/blog" class="marquee-link">Blog</a>
          <span class="marquee-sep">·</span>
          <a href="/about" class="marquee-link">About</a>
          <span class="marquee-sep">·</span>
          <a href="https://v1.favo02.dev" target="_blank" rel="noopener noreferrer" class="marquee-link">v1.favo02.dev</a>
          <span class="marquee-sep">·</span>
        </span>
      ))}
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="footer-bottom container-wide">
    <span class="mono-sm">© {new Date().getFullYear()} Luca Favini</span>
    <span class="mono-sm footer-domain">favo02.dev</span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-4xl);
    border-top: 1px solid var(--border);
    overflow: hidden;
  }

  /* ── Big name block ── */
  .footer-top {
    padding: var(--space-2xl) 0 var(--space-xl);
  }

  .footer-name-wrap {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .footer-eyebrow {
    color: var(--text-faint);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
  }

  .footer-name {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 10vw, 8rem);
    font-weight: 300;
    line-height: 0.92;
    letter-spacing: -0.03em;
    color: var(--text);
    margin: 0;
    /* Subtle tonal shift on second line via text fill isn't possible in CSS,
       so we use opacity on the whole block and rely on the size for impact */
  }

  /* ── Marquee strip ── */
  .marquee-strip {
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    padding: var(--space-sm) 0;
    overflow: hidden;
    white-space: nowrap;
    /* Pause on hover */
  }

  .marquee-strip:hover .marquee-track {
    animation-play-state: paused;
  }

  .marquee-track {
    display: inline-flex;
    align-items: center;
    gap: 0;
    animation: marquee-scroll 28s linear infinite;
    will-change: transform;
  }

  @keyframes marquee-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  .marquee-set {
    display: inline-flex;
    align-items: center;
    gap: var(--space-lg);
    padding: 0 var(--space-lg);
  }

  .marquee-link {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--text-faint);
    text-decoration: none;
    transition: color var(--transition-fast);
    white-space: nowrap;
  }

  .marquee-link:hover {
    color: var(--accent);
  }

  .marquee-email {
    cursor: default;
    /* obfuscation hint is enough at this size */
  }

  .marquee-sep {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--border);
    flex-shrink: 0;
  }

  /* ── Bottom bar ── */
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-md) 0 var(--space-lg);
  }

  .footer-domain {
    color: var(--text-faint);
  }

  @media (max-width: 640px) {
    .footer-name {
      font-size: clamp(3rem, 14vw, 5rem);
    }

    .footer-bottom {
      flex-direction: column;
      gap: var(--space-xs);
      align-items: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
