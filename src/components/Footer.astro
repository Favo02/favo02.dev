<footer class="site-footer">
  <!--
    Chessboard layout:
    ┌─────────────────┬──────────────────────┐
    │  favo02         │  site links          │
    ├─────────────────┼──────────────────────┤
    │  Luca Favini    │  contacts            │
    └─────────────────┴──────────────────────┘
  -->
  <div class="footer-grid container-wide">
    <!-- Top-left: handle -->
    <div class="cell cell--tl">
      <p class="handle">favo02</p>
    </div>

    <!-- Top-right: site nav links -->
    <div class="cell cell--tr">
      <nav class="footer-nav" aria-label="Footer navigation">
        <a href="/projects" class="footer-link">Projects</a>
        <a href="/about" class="footer-link">About</a>
        <a href="/now" class="footer-link">Now</a>
        <a href="/blog" class="footer-link">Blog</a>
        <a
          href="https://v1.favo02.dev"
          target="_blank"
          rel="noopener noreferrer"
          class="footer-link footer-link--faint"
        >
          v1
        </a>
      </nav>
    </div>

    <!-- Bottom-left: full name -->
    <div class="cell cell--bl">
      <p class="full-name">
        <span class="full-name-first">Luca</span>
        <span class="full-name-last">Favini</span>
      </p>
      <p class="copyright mono-sm">© {new Date().getFullYear()}</p>
    </div>

    <!-- Bottom-right: contacts -->
    <div class="cell cell--br">
      <div class="contacts">
        <a
          href="https://github.com/Favo02"
          target="_blank"
          rel="noopener noreferrer"
          class="contact-link"
        >
          <span class="contact-label mono-sm">GitHub</span>
          <span class="contact-value mono-sm">Favo02</span>
        </a>
        <a
          href="https://linkedin.com/in/lucafavini"
          target="_blank"
          rel="noopener noreferrer"
          class="contact-link"
        >
          <span class="contact-label mono-sm">LinkedIn</span>
          <span class="contact-value mono-sm">lucafavini</span>
        </a>
        <div class="contact-link contact-link--email">
          <span class="contact-label mono-sm">Email</span>
          <span
            class="contact-value mono-sm"
            title="Dumb and bot filter: if you can't correctly understand this email you shouldn't contact me."
          >
            me AT favo02.dev
          </span>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-4xl);
    border-top: 1px solid var(--border);
  }

  /* ── Chessboard grid ── */
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto auto;
  }

  .cell {
    padding: var(--space-xl) var(--space-lg);
  }

  /* Top row cells separated by a hairline column divider */
  .cell--tl {
    border-right: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    display: flex;
    align-items: flex-end;
  }

  .cell--tr {
    border-bottom: 1px solid var(--border-subtle);
    display: flex;
    align-items: flex-end;
  }

  /* Bottom row */
  .cell--bl {
    border-right: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-lg);
    padding-top: var(--space-lg);
    padding-bottom: var(--space-xl);
  }

  .cell--br {
    display: flex;
    align-items: flex-end;
    padding-top: var(--space-lg);
    padding-bottom: var(--space-xl);
  }

  /* ── Handle (favo02) ── */
  .handle {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--text-faint);
    margin: 0;
  }

  /* ── Site nav ── */
  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-lg);
  }

  .footer-link {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer-link:hover {
    color: var(--accent);
  }

  .footer-link--faint {
    color: var(--text-faint);
  }

  /* ── Full name ── */
  .full-name {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 5.5rem);
    line-height: 0.92;
    letter-spacing: -0.025em;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .full-name-first {
    font-weight: 400;
    font-style: italic;
    color: var(--text-muted);
  }

  .full-name-last {
    font-weight: 700;
    color: var(--text);
  }

  .copyright {
    color: var(--text-faint);
    margin: 0;
  }

  /* ── Contacts ── */
  .contacts {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    width: 100%;
  }

  .contact-link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    text-decoration: none;
    color: var(--text-muted);
    transition: color var(--transition-fast);
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: var(--space-sm);
  }

  a.contact-link:hover {
    color: var(--accent);
  }

  .contact-link--email {
    cursor: default;
  }

  .contact-label {
    color: var(--text-faint);
    flex-shrink: 0;
  }

  .contact-value {
    text-align: right;
  }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .cell--tl,
    .cell--tr,
    .cell--bl,
    .cell--br {
      border-right: none;
    }

    .cell--tl {
      border-bottom: none;
      padding-bottom: 0;
    }

    .cell--tr {
      padding-top: var(--space-sm);
    }

    .cell--bl {
      border-top: 1px solid var(--border-subtle);
    }

    .full-name {
      font-size: clamp(2.5rem, 12vw, 4rem);
    }
  }
</style>
