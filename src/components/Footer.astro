---
---

<footer class="site-footer">
  <!-- Top rule + big name -->
  <div class="footer-top">
    <div class="footer-name-wrap container-wide">
      <p class="footer-name">Luca<br />Favini</p>
    </div>
  </div>

  <!-- Static link band -->
  <div class="footer-band">
    <div class="band-inner container-wide">
      <div class="band-links">
        <a href="/projects" class="band-link">Projects</a>
        <span class="band-sep">·</span>
        <a href="/about" class="band-link">About</a>
        <span class="band-sep">·</span>
        <a href="/now" class="band-link">Now</a>
        <span class="band-sep">·</span>
        <a href="/blog" class="band-link">Blog</a>
        <span class="band-sep">·</span>
        <a href="https://v1.favo02.dev" target="_blank" rel="noopener noreferrer" class="band-link">v1</a>
      </div>

      <div class="band-socials">
        <a href="https://github.com/Favo02" target="_blank" rel="noopener noreferrer" class="band-link">GitHub</a>
        <span class="band-sep">·</span>
        <a href="https://linkedin.com/in/lucafavini" target="_blank" rel="noopener noreferrer" class="band-link">LinkedIn</a>
        <span class="band-sep">·</span>
        <span class="band-link band-email" title="Dumb bot filter — read it if you can">
          luca.favini.02 AT gmail.com
        </span>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="footer-bottom container-wide">
    <span class="mono-sm">© {new Date().getFullYear()} Luca Favini</span>
    <span class="mono-sm footer-domain">favo02.dev</span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-4xl);
    border-top: 1px solid var(--border);
    overflow: hidden;
  }

  /* ── Big name block ── */
  .footer-top {
    padding: var(--space-2xl) 0 var(--space-xl);
  }

  .footer-name-wrap {
    display: flex;
    flex-direction: column;
  }

  .footer-name {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 10vw, 8rem);
    font-weight: 400;
    line-height: 0.92;
    letter-spacing: -0.03em;
    font-style: italic;
    color: var(--text);
    margin: 0;
  }

  /* ── Static band ── */
  .footer-band {
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    padding: var(--space-md) 0;
  }

  .band-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
    flex-wrap: wrap;
  }

  .band-links,
  .band-socials {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .band-link {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--text-faint);
    text-decoration: none;
    transition: color var(--transition-fast);
    white-space: nowrap;
  }

  .band-link:hover {
    color: var(--accent);
  }

  .band-email {
    cursor: default;
  }

  .band-email:hover {
    color: var(--text-muted);
  }

  .band-sep {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--border);
    flex-shrink: 0;
    user-select: none;
  }

  /* ── Bottom bar ── */
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-md) 0 var(--space-lg);
  }

  .footer-domain {
    color: var(--text-faint);
  }

  @media (max-width: 640px) {
    .footer-name {
      font-size: clamp(3rem, 14vw, 5rem);
    }

    .band-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-md);
    }

    .footer-bottom {
      flex-direction: column;
      gap: var(--space-xs);
      align-items: flex-start;
    }
  }
</style>
