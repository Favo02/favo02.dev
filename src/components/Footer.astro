        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </a>
      <div class="email-container">
        <span class="obfuscated-email mono-sm">
          <span class="underline-dotted">luca.favini.02</span>
          <span class="italic"> AT </span>
          <span class="underline-dotted">gmail.com</span>
        </span>
        <span class="email-tooltip">Dumb and bot filter: if you can't correctly understand this email you shouldn't contact me.</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border-subtle);
    padding: var(--space-xl) 0;
    margin-top: var(--space-4xl);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .footer-left {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .footer-divider {
    color: var(--border);
  }

  .v1-link {
    color: var(--text-faint);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .v1-link:hover {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 3px;
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  .footer-icon {
    color: var(--text-faint);
    transition: color var(--transition-fast);
    display: flex;
    align-items: center;
  }

  .footer-icon:hover {
    color: var(--text);
  }

  .email-container {
    position: relative;
    display: flex;
    align-items: center;
    color: var(--text-faint);
    cursor: default;
  }
  
  .email-container:hover {
    color: var(--text);
  }

  .underline-dotted {
    text-decoration: underline;
    text-decoration-style: dotted;
    text-underline-offset: 4px;
  }

  .email-tooltip {
    position: absolute;
    bottom: 100%;
    right: 0;
    margin-bottom: var(--space-sm);
    width: 250px;
    background: var(--bg-elevated);
    color: var(--text);
    font-size: var(--text-xs);
    padding: var(--space-sm);
    border-radius: 4px;
    border: 1px solid var(--border);
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--transition-fast), visibility var(--transition-fast);
    text-align: center;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    z-index: 10;
  }

  .email-container:hover .email-tooltip {
    opacity: 1;
    visibility: visible;
  }

  @media (max-width: 640px) {
    .footer-inner {
      flex-direction: column;
      gap: var(--space-md);
      text-align: center;
    }
    
    .email-tooltip {
      right: 50%;
      transform: translateX(50%);
    }
  }
</style>
