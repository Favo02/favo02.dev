---
const repo = import.meta.env.PUBLIC_GISCUS_REPO;
const repoId = import.meta.env.PUBLIC_GISCUS_REPO_ID;
const category = import.meta.env.PUBLIC_GISCUS_CATEGORY;
const categoryId = import.meta.env.PUBLIC_GISCUS_CATEGORY_ID;

const isConfigured = !!(repo && repoId && category && categoryId);
const isDev = import.meta.env.DEV;
---

{isConfigured ? (
  <section class="comments-section">
    <div class="giscus-wrapper">
      <div class="giscus"></div>
    </div>
  </section>

  <script is:inline define:vars={{ repo, repoId, category, categoryId }}>
    function loadGiscus() {
      // Remove any existing giscus script to prevent duplicate runs (e.g. Astro swap)
      const existingScript = document.getElementById('giscus-script');
      if (existingScript) {
        existingScript.remove();
      }

      // Determine current theme
      const theme = document.documentElement.getAttribute("data-theme") === "dark" ? "dark" : "light";

      // Create and append the script
      const script = document.createElement("script");
      script.id = 'giscus-script';
      script.src = "https://giscus.app/client.js";
      script.setAttribute("data-repo", repo);
      script.setAttribute("data-repo-id", repoId);
      script.setAttribute("data-category", category);
      script.setAttribute("data-category-id", categoryId);
      script.setAttribute("data-mapping", "pathname");
      script.setAttribute("data-strict", "0");
      script.setAttribute("data-reactions-enabled", "1");
      script.setAttribute("data-emit-metadata", "0");
      script.setAttribute("data-input-position", "bottom");
      script.setAttribute("data-theme", theme);
      script.setAttribute("data-lang", "en");
      script.crossOrigin = "anonymous";
      script.async = true;

      const container = document.querySelector(".giscus");
      if (container) {
        container.innerHTML = ''; // Clear container
        container.appendChild(script);
      }
    }

    // Load Giscus on mount
    loadGiscus();

    // Support Astro Page Transitions / View Transitions
    document.addEventListener("astro:after-swap", loadGiscus);

    // Watch for theme changes dynamically
    const observer = new MutationObserver(() => {
      const theme = document.documentElement.getAttribute("data-theme") === "dark" ? "dark" : "light";
      const iframe = document.querySelector('iframe.giscus-frame');
      if (iframe && iframe.src.includes('giscus.app')) {
        iframe.contentWindow.postMessage(
          {
            giscus: {
              setConfig: {
                theme: theme
              }
            }
          },
          'https://giscus.app'
        );
      }
    });

    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"]
    });

    // Clean up observer and listeners on view transition to avoid memory leaks
    document.addEventListener("astro:before-swap", () => {
      observer.disconnect();
      document.removeEventListener("astro:after-swap", loadGiscus);
    }, { once: true });
  </script>
) : isDev ? (
  <section class="comments-section-placeholder">
    <div class="placeholder-card">
      <h3>💬 Comments Section (Giscus)</h3>
      <p>Comments are ready to be enabled! To show comments here, configure your Giscus environment variables in your <code>.env</code> file:</p>
      <pre><code>{`PUBLIC_GISCUS_REPO="your-github-username/your-repo"
PUBLIC_GISCUS_REPO_ID="your-repo-id"
PUBLIC_GISCUS_CATEGORY="Announcements"
PUBLIC_GISCUS_CATEGORY_ID="your-category-id"`}</code></pre>
      <p class="placeholder-tip">Tip: Get these credentials by visiting <a href="https://giscus.app" target="_blank" rel="noopener noreferrer">giscus.app</a> and filling in your repository details.</p>
    </div>
  </section>
) : null}

<style>
  .comments-section {
    padding-top: var(--space-xl);
  }

  .comments-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 400;
    margin-bottom: var(--space-xl);
    color: var(--text);
  }

  .giscus-wrapper {
    min-height: 150px;
  }

  /* Placeholder Styling for Development */
  .comments-section-placeholder {
    margin-top: var(--space-3xl);
    padding-top: var(--space-xl);
    border-top: 1px dashed var(--border);
  }

  .placeholder-card {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: var(--space-lg);
    font-family: var(--font-body);
  }

  .placeholder-card h3 {
    font-family: var(--font-display);
    font-size: var(--text-base);
    margin-top: 0;
    margin-bottom: var(--space-sm);
    color: var(--accent);
  }

  .placeholder-card p {
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-md);
  }

  .placeholder-card pre {
    background: var(--code-bg);
    border: 1px solid var(--border-subtle);
    padding: var(--space-md);
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    overflow-x: auto;
    margin-bottom: var(--space-md);
    color: var(--text);
  }

  .placeholder-tip {
    font-size: var(--text-xs) !important;
    margin-bottom: 0 !important;
  }

  .placeholder-card a {
    color: var(--accent);
    text-decoration: underline;
  }

  .placeholder-card a:hover {
    color: var(--accent-hover);
  }
</style>
