---
import BaseLayout from "../layouts/BaseLayout.astro"
import PageHeader from "../components/PageHeader.astro"

// All timeline entries in a single flat list. They'll be sorted newest-first
// Set compact: true for secondary items (e.g. certificates, minor events)
const timeline = [
  // EDUCATION
  {
    type: "education" as const,
    period: "Oct 2025 — Present",
    title: "Università degli Studi di Milano",
    org: "Milan",
    description: "Master in computer science (magistrale informatica)",
    link: "https://www.unimi.it/en/education/master-programme/computer-science-master",
    result: null,
    compact: false,
  },
  {
    type: "education" as const,
    period: "Oct 2021 — Feb 2025",
    title: "Università degli Studi di Milano",
    org: "Milan",
    description: "Bachelor in computer science (triennale informatica)",
    link: "https://www.unimi.it/en/education/bachelor/computer-science",
    result: "102/110",
    compact: false,
  },
  {
    type: "education" as const,
    period: "Sep 2016 — Jun 2021",
    title: "ITIS Cannizzaro",
    org: "Rho",
    description: "High school in computer science (ITIS indirizzo informatica)",
    link: "https://www.itiscannizzaro.edu.it/pagine/-informatica",
    result: "100/100",
    compact: false,
  },

  // PUBLICATION
  {
    type: "publication" as const,
    period: "Jan 2026",
    title:
      "Prioritizing Configuration Relevance via Compiler-Based Refined Feature Ranking",
    org: "arXiv",
    description: "",
    link: "https://arxiv.org/abs/2601.16008",
    result: null,
    compact: true,
  },

  // EXPERIENCE
  {
    type: "experience" as const,
    period: "Feb 2024 — Present",
    title: "Programming Tutor",
    org: "Università degli Studi di Milano",
    description: 'Tutor for "Programmazione I" course (in Golang)',
    link: null,
    result: null,
    compact: false,
  },
  {
    type: "experience" as const,
    period: "Oct 2024 — Feb 2025",
    title: "Software Developer",
    org: "Tecnostamp Triulzi",
    description:
      "Improved PHP CodeIgniter/MySQL app and automated barcode scanner integration",
    link: null,
    result: null,
    compact: false,
  },

  // EVENT
  {
    type: "event" as const,
    period: "Nov 2025",
    title: "ICPC SWERC 2025",
    org: "Pisa — Competitive Programming Contest",
    description: "",
    link: "https://swerc.eu/2025/",
    result: null,
    compact: true,
  },
  {
    type: "event" as const,
    period: "Dec 2024",
    title: "ICPC SWERC 2024",
    org: "Pisa — Competitive Programming Contest",
    description: "",
    link: "https://swerc.eu/2024/",
    result: null,
    compact: true,
  },
  {
    type: "event" as const,
    period: "Aug 2024",
    title: "NOI Hackathon Summer 2024",
    org: "NOI Techpark Südtirol",
    description: "",
    link: "https://hackathon.bz.it/",
    result: null,
    compact: true,
  },
  {
    type: "event" as const,
    period: "May 2024",
    title: "Cyberchallenge 2024",
    org: "Cybersecurity National Lab",
    description: "",
    link: "https://cyberchallenge.it/",
    result: null,
    compact: true,
  },
  {
    type: "event" as const,
    period: "Nov 2023",
    title: "NOI Hackathon SFSCON 2023",
    org: "NOI Techpark Südtirol",
    description: "",
    link: "https://hackathon.bz.it/",
    result: null,
    compact: true,
  },
  {
    type: "event" as const,
    period: "Aug 2023",
    title: "NOI Hackathon Summer 2023",
    org: "NOI Techpark Südtirol",
    description: "",
    link: "https://hackathon.bz.it/",
    result: null,
    compact: true,
  },
  {
    type: "event" as const,
    period: "Mar 2019",
    title: "NAO Challenge 2019",
    org: "Robotics High School Competition",
    description: "",
    link: "https://naochallenge.it/",
    result: null,
    compact: true,
  },

  // CERTIFICATE
  {
    type: "certificate" as const,
    period: "2022",
    title: "FullStackOpen",
    org: "University of Helsinki (Remote)",
    description: "Modern Full Stack Web Development",
    link: "https://fullstackopen.com/en",
    result: null,
    compact: true,
  },
  {
    type: "certificate" as const,
    period: "2021",
    title: "Elements of AI",
    org: "MinnaLearn & Univ. of Helsinki (Remote)",
    description: "Artificial intelligence introductory course",
    link: "https://www.elementsofai.com",
    result: null,
    compact: true,
  },
  {
    type: "certificate" as const,
    period: "2021",
    title: "English B2 First",
    org: "Cambridge English",
    description: "Cambridge English B2 qualification",
    link: "https://www.cambridgeenglish.org/exams-and-tests/first",
    result: null,
    compact: true,
  },
].sort((a, b) => {
  const parsePeriodToDate = (period: string) => {
    // Use end date when a range is provided (e.g. "Oct 2021 — Feb 2025").
    // Treat "Present" as current date.
    const parts = period.split(/—|–|-/).map((s) => s.trim())
    const target = parts.length > 1 ? parts[1] : parts[0]
    if (/present/i.test(target)) return new Date()
    // Year-only like "2022"
    if (/^\d{4}$/.test(target)) return new Date(Number(target), 0, 1)
    const d = new Date(target)
    if (!Number.isNaN(d.getTime())) return d
    // Fallback to current date if parsing fails
    return new Date()
  }

  const da = parsePeriodToDate(a.period)
  const db = parsePeriodToDate(b.period)
  return db.getTime() - da.getTime()
})

const typeLabel: Record<(typeof timeline)[number]["type"], string> = {
  experience: "experience",
  education: "education",
  certificate: "certificate",
  event: "event",
  publication: "publication",
}

const calculateAge = (birthday: Date) => {
  const ageDifMs = Date.now() - birthday.getTime()
  const ageDate = new Date(ageDifMs)
  return Math.abs(ageDate.getUTCFullYear() - 1970)
}

const myAge = calculateAge(new Date("August 25, 2002"))
---

<BaseLayout title="About" description="Who is Luca?">
  <div class="about-page">
    <PageHeader title="About" subtitle="Who is Luca?" />

    <!-- ── Intro: photo wraps alternating left and right ── -->
    <section class="intro-section">
      <div class="intro-text">
        <div class="intro-bio">
          <p>
            Hello! I am <strong>Luca</strong>, but my friends call me <strong
              >Favo</strong
            >. I am a {myAge}-year-old guy living near
            <strong>Milan, Italy</strong>.
          </p>

          <div class="photo-wrap photo-wrap--left">
            <img
              src="/studying.webp"
              alt="Studying"
              class="propic"
              loading="eager"
            />
          </div>

          <p>
            I am currently pursuing a Master's degree in <strong
              >computer science</strong
            > at the <strong>Università degli Studi di Milano</strong>. I am
            exploring various specialization areas, ranging from <em
              >algorithmic game theory</em
            > and <em>programming languages</em> (I occasionally collaborate with
            the <a
              href="https://cazzola.di.unimi.it/adapt-lab.html"
              target="_blank"
              rel="noopener noreferrer">AdaptLab</a
            > research group, where I completed my Bachelor's thesis) to <em
              >DevOps</em
            > — but above all, I love <strong>competitive programming</strong>.
          </p>

          <p>
            I strongly adhere to the <strong>open source</strong> movement (or at
            least <strong>open data</strong>, meaning I want my data in a
            decent, portable format) trying to avoid closed software where
            viable alternatives exist, especially <em>self-hosted</em> solutions in
            my
            <strong>homelab</strong>.
          </p>

          <p>
            For more details about my <strong>projects</strong>, check out the
            dedicated
            <a href="/projects">projects page</a>. You can also see what I am
            currently working on (or what I've been up to recently) on my <a
              href="/now">now page</a
            >, which I try to keep regularly updated.
          </p>

          <div class="photo-wrap photo-wrap--right">
            <img
              src="/hiking.webp"
              alt="Hiking"
              class="propic"
              loading="eager"
            />
          </div>

          <p>
            I have a strong passion for playing almost <strong>any sport</strong
            >: I regularly play <strong>football</strong>, <strong>run</strong>
            and <strong>hike</strong>. <em
              ><a
                href="https://www.strava.com/athletes/favo02"
                target="_blank"
                rel="noopener noreferrer">Strava profile</a
              > (suggest an open alternative?)</em
            >
          </p>

          <p>
            On the gaming side, I once considered myself a decent <strong
              >competitive player</strong
            >, playing under the alias of <em><strong>imprudenza</strong></em>
            <a
              href="https://linktr.ee/imprudenza"
              target="_blank"
              rel="noopener noreferrer"><em>(socials linktree)</em></a
            >. In the past, I competed in <em>Minecraft CWBW</em>, becoming the <span
              title="PigParty BedWars league, 4v4 on PigParty"
              ><em>2018 Italian Champion</em></span
            > with <em>Rebirth</em>. Later, I transitioned to <strong
              >Rainbow Six Siege</strong
            >, where I secured second place in the <a
              href="https://liquipedia.net/rainbowsix/PG_Nationals/2022/BeSerious/Spring"
              target="_blank"
              rel="noopener noreferrer"
              title="BeSerious Spring 2022"
              ><em>2022 Italian Second Division</em></a
            > with <em>P11</em>. In recent years, I completely <strong
              >stopped</strong
            > playing.
          </p>

          <p>
            I am a <strong>competitive</strong> animal. I don't care if it's a friendly
            football game, a random Codeforces contest, a weekly run or a casual Rainbow
            Six game; I always want to win and excel.
          </p>
          <p>
            <em>Last but not least:</em> you can recognize me in real life by the
            <a href="/smurf.webp" target="_blank" rel="noopener noreferrer"
              ><strong>Smurf</strong></a
            > attached to my backpack.
          </p>

          <p class="bio-footnote mono-sm">
            Contact &amp; socials in the footer. CV and certificates available
            on request.
          </p>
        </div>
      </div>
      <!-- clearfix so section stretches past the float -->
      <div style="clear:both"></div>
    </section>

    <section class="timeline-section">
      <h2 class="section-label mono">Background</h2>
      <ul class="timeline-list">
        {
          timeline.map((item) => (
            <li class:list={["tl-item", { "tl-item--compact": item.compact }]}>
              {item.compact ? (
                /* ── Compact: single tight row ── */
                <>
                  <span class="tl-period mono-sm">{item.period}</span>
                  <div class="tl-compact-body">
                    {item.link ? (
                      <a
                        href={item.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="tl-title tl-title--compact"
                      >
                        {item.title}
                      </a>
                    ) : (
                      <span class="tl-title tl-title--compact">
                        {item.title}
                      </span>
                    )}
                    <span class="tl-compact-org mono-sm">{item.org}</span>
                  </div>
                  <span class:list={["tl-tag", `tl-tag--${item.type}`]}>
                    {typeLabel[item.type]}
                  </span>
                </>
              ) : (
                /* ── Full: richer card ── */
                <>
                  <span class="tl-period mono-sm">{item.period}</span>
                  <div class="tl-body">
                    <div class="tl-top">
                      <div class="tl-title-wrap">
                        {item.link ? (
                          <a
                            href={item.link}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="tl-title"
                          >
                            {item.title}
                          </a>
                        ) : (
                          <span class="tl-title">{item.title}</span>
                        )}
                        <p class="tl-meta mono-sm">{item.org}</p>
                      </div>
                      <div class="tl-badges">
                        {item.result && (
                          <span class="tl-result">{item.result}</span>
                        )}
                        <span class:list={["tl-tag", `tl-tag--${item.type}`]}>
                          {typeLabel[item.type]}
                        </span>
                      </div>
                    </div>
                    {item.description && (
                      <p class="tl-desc">{item.description}</p>
                    )}
                  </div>
                </>
              )}
            </li>
          ))
        }
      </ul>
    </section>
  </div>

  <style>
    .about-page {
      padding-top: var(--space-2xl);
      display: flex;
      flex-direction: column;
      gap: var(--space-xl);
    }

    /* ── Intro ── */
    .intro-section {
      margin-bottom: var(--space-3xl);
      /* float layout: photo floats left, text wraps around it */
    }

    .photo-wrap {
      width: 220px;
      aspect-ratio: 3 / 4;
      margin-bottom: var(--space-lg);
      overflow: hidden;
      border-radius: 4px;
    }

    .photo-wrap--left {
      float: left;
      margin-right: var(--space-xl);
      shape-outside: margin-box;
    }

    .photo-wrap--right {
      float: right;
      margin-left: var(--space-xl);
      shape-outside: margin-box;
    }

    .propic {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 20%;
      filter: grayscale(15%);
      transition: filter var(--transition-base);
    }

    .propic:hover {
      filter: grayscale(0%);
    }

    .intro-text {
      /* nothing needed — flows around the float */
    }

    .intro-name {
      font-family: var(--font-display);
      font-size: clamp(2.5rem, 5vw, 4.5rem);
      line-height: 0.95;
      letter-spacing: -0.02em;
      color: var(--text);
      margin-bottom: var(--space-xl);
      font-weight: 700;
      font-style: normal;
    }

    .intro-name em {
      font-style: italic;
      font-weight: 400;
      color: var(--text-muted);
    }

    /* ── Bio prose ── */
    .intro-bio p {
      font-size: var(--text-base);
      line-height: var(--leading-normal);
      color: var(--text-muted);
      margin-bottom: var(--space-md);
    }

    .intro-bio strong {
      color: var(--text);
      font-weight: 600;
    }

    .intro-bio a {
      color: var(--text-muted);
      text-decoration: underline;
      text-decoration-color: var(--border);
      text-underline-offset: 3px;
      transition:
        color var(--transition-fast),
        text-decoration-color var(--transition-fast);
    }

    .intro-bio a:hover {
      color: var(--accent);
      text-decoration-color: var(--accent);
    }

    .opacity-70 {
      opacity: 0.7;
    }

    .bio-footnote {
      margin-top: var(--space-xl);
      padding-top: var(--space-md);
      border-top: 1px solid var(--border-subtle);
      color: var(--text-faint) !important;
      font-size: var(--text-xs) !important;
      margin-bottom: 0;
    }

    /* ── Section label ── */
    .section-label {
      font-size: var(--text-xs) !important;
      font-family: var(--font-mono) !important;
      text-transform: uppercase;
      letter-spacing: var(--tracking-wider);
      color: var(--text-faint);
      margin-bottom: var(--space-lg);
      font-weight: 500;
    }

    /* ── Unified timeline list ── */
    .timeline-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
    }

    .tl-item:first-child {
      border-top: 1px solid var(--border-subtle);
    }

    /* ── Full item ── */
    .tl-item {
      display: grid;
      grid-template-columns: 160px 1fr;
      gap: var(--space-lg);
      padding: var(--space-lg) 12px;
      margin: 0 -12px;
      border-bottom: 1px solid var(--border-subtle);
      border-left: 2px solid transparent;
      border-radius: 6px;
      transition:
        background-color var(--transition-fast),
        opacity var(--transition-fast);
    }

    /* ── Compact item: three-column strip ── */
    .tl-item--compact {
      grid-template-columns: 72px 1fr auto;
      align-items: center;
      gap: var(--space-md);
      padding: 0.35rem 12px;
      margin: 0 -12px;
      border-left: 2px solid transparent;
      border-radius: 6px;
    }

    .tl-item:hover {
      background: color-mix(in srgb, var(--bg-surface) 45%, transparent);
    }

    .tl-item:hover .tl-title {
      color: var(--accent);
    }

    .tl-item:hover .tl-title--compact {
      color: var(--accent);
    }

    .tl-period {
      padding-top: 3px;
      white-space: nowrap;
      color: var(--text-faint);
    }

    .tl-item--compact .tl-period {
      font-size: 0.67rem;
      padding-top: 0;
    }

    /* Compact body: title + org stacked, fills middle column */
    .tl-compact-body {
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 1px;
    }

    .tl-title--compact {
      font-size: var(--text-sm) !important;
      font-style: normal !important;
      font-weight: 500 !important;
      font-family: var(--font-body) !important;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .tl-compact-org {
      font-size: 0.67rem;
      color: var(--text-faint);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    /* Tag in compact items stays in the third column */
    .tl-item--compact .tl-tag {
      flex-shrink: 0;
      font-size: 0.55rem;
    }

    .tl-body {
      display: flex;
      flex-direction: column;
      gap: var(--space-xs);
    }

    .tl-top {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: var(--space-md);
    }

    .tl-title-wrap {
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .tl-title {
      font-family: var(--font-display);
      font-size: var(--text-base);
      font-weight: 400;
      font-style: italic;
      color: var(--text);
      text-decoration: none;
      line-height: var(--leading-snug);
      transition: color var(--transition-fast);
    }

    a.tl-title:hover {
      color: var(--accent);
    }

    .tl-badges {
      display: flex;
      align-items: center;
      gap: var(--space-sm);
      flex-shrink: 0;
      justify-content: flex-end;
      padding-top: 3px;
    }

    .tl-result {
      font-family: var(--font-mono);
      font-size: 0.65rem;
      text-transform: uppercase;
      letter-spacing: var(--tracking-wider);
      color: var(--accent);
      white-space: nowrap;
    }

    /* Type tags */
    .tl-tag {
      font-family: var(--font-mono);
      font-size: 0.6rem;
      text-transform: uppercase;
      letter-spacing: var(--tracking-wider);
      padding: 0.15em 0.55em;
      border-radius: 3px;
      border: 1px solid;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .tl-tag--experience {
      color: var(--tag-personal);
      border-color: var(--tag-personal);
    }

    .tl-tag--education {
      color: var(--tag-academic);
      border-color: var(--tag-academic);
    }

    .tl-tag--certificate {
      color: var(--text-faint);
      border-color: var(--border);
    }

    .tl-tag--event {
      color: var(--accent);
      border-color: var(--accent);
    }

    .tl-tag--publication {
      color: var(--tag-contributions);
      border-color: var(--tag-contributions);
    }

    .tl-meta {
      color: var(--text-faint);
      margin: 0;
    }

    .tl-desc {
      font-size: var(--text-sm);
      color: var(--text-muted);
      margin: 0;
      line-height: var(--leading-normal);
    }

    /* ── Responsive ── */
    @media (max-width: 768px) {
      .photo-wrap {
        float: none !important;
        width: 100%;
        aspect-ratio: auto !important;
        margin-left: 0 !important;
        margin-right: 0 !important;
        margin-bottom: var(--space-xl);
      }

      .propic {
        height: auto;
        aspect-ratio: 3 / 4;
        max-height: 320px;
        object-position: center 25%;
      }

      .intro-name {
        font-size: clamp(2.5rem, 10vw, 4rem);
      }

      .tl-item {
        grid-template-columns: 1fr;
        gap: var(--space-xs);
      }

      .tl-item--compact {
        grid-template-columns: 60px 1fr auto !important;
        gap: var(--space-sm) !important;
        padding: 0.5rem 12px !important;
        margin: 0 -12px !important;
        align-items: flex-start !important;
      }

      .tl-item--compact .tl-period {
        font-size: 0.65rem;
        padding-top: 2px;
      }

      .tl-item--compact .tl-title--compact {
        white-space: normal !important;
      }

      .tl-item--compact .tl-compact-org {
        white-space: normal !important;
      }

      .tl-item--compact .tl-tag {
        font-size: 0.55rem;
        padding: 0.1em 0.4em;
        align-self: flex-start;
        margin-top: 2px;
      }

      .tl-period {
        padding-top: 0;
      }
    }
  </style>
</BaseLayout>
