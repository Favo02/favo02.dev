---
import BaseLayout from "../layouts/BaseLayout.astro"
import PageHeader from "../components/PageHeader.astro"
import { getEntry } from "astro:content"
import { marked } from "marked"

export const prerender = true

// Fetch the single "now" entry (now.md)
const entry = await getEntry("now", "now")
if (!entry) {
  throw new Error("Could not find now.md entry")
}

const lastUpdated = entry.data.updated
const rawBody = entry.body || ""

// Split the body by heading ##
const sectionsRaw = rawBody.split(/(?=^##\s+)/m)

// Configure marked to escape any raw HTML input to mitigate XSS risks
const renderer = {
  html(token: { text: string }) {
    return token.text.replace(/</g, "&lt;").replace(/>/g, "&gt;")
  },
}
marked.use({ renderer })

const sections = sectionsRaw
  .map((chunk) => {
    const match = chunk.match(/^##\s+(.+)$/m)
    if (!match) return null
    const title = match[1].trim()
    const contentMarkdown = chunk.replace(/^##\s+.+$/m, "").trim()
    const contentHtml = marked.parse(contentMarkdown)
    return {
      title,
      contentHtml,
      isCurrent: false,
    }
  })
  .filter((s): s is NonNullable<typeof s> => s !== null)

// Set isCurrent to true for the first section (top of the file)
if (sections.length > 0) {
  sections[0].isCurrent = true
}
---

<BaseLayout
  title="Now"
  description="What Luca is doing right now — a /now page."
>
  <div class="now-page">
    <PageHeader title="Now" subtitle="A snapshot of what I'm currently doing.">
      <Fragment slot="meta">
        <a
          href="https://nownownow.com/about"
          target="_blank"
          rel="noopener noreferrer"
          class="meta-link"
        >
          What is a now page</a
        >
        — Last updated: <time datetime={lastUpdated.toISOString()}>
          {
            lastUpdated.toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })
          }
        </time>
      </Fragment>
    </PageHeader>

    <div class="now-list">
      {
        sections.map((section) => (
          <section
            class:list={["now-row", { "is-current": section.isCurrent }]}
            aria-label={`Update from ${section.title}`}
          >
            <header class="now-header">
              <h2 class="now-month">{section.title}</h2>
              {section.isCurrent && (
                <span class="now-current-badge">Current</span>
              )}
            </header>

            <div class="now-content-col">
              <div class="now-log-content" set:html={section.contentHtml} />
            </div>
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .now-page {
    padding-top: var(--space-2xl);
  }

  .meta-link {
    color: var(--text-muted);
    text-decoration: underline;
    text-decoration-color: var(--border-subtle);
    text-underline-offset: 3px;
    transition: all var(--transition-fast);
  }

  .meta-link:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  /* ── Timeline Grid List ── */
  .now-list {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-xl);
    max-width: var(--max-width-prose);
  }

  .now-row:first-child {
    border-top: 1px solid var(--border-subtle);
  }

  .now-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-md) 12px;
    margin: 0 -12px;
    border-bottom: 1px solid var(--border-subtle);
    border-radius: 6px;
    transition:
      background-color var(--transition-fast),
      opacity var(--transition-fast);
  }

  .now-row:hover {
    background: color-mix(in srgb, var(--bg-surface) 45%, transparent);
  }

  /* ── Highlighted current log ── */
  .now-row.is-current {
    background: color-mix(in srgb, var(--accent) 2%, transparent);
  }

  .now-row.is-current:hover {
    background: color-mix(in srgb, var(--accent) 5%, transparent);
  }

  /* ── Header Area ── */
  .now-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .now-month {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--text);
    margin: 0;
    line-height: var(--leading-tight);
  }

  /* ── Current Badge ── */
  .now-current-badge {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    padding: 0.15em 0.5em;
    border-radius: 4px;
    border: 1px solid var(--accent);
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 5%, transparent);
    white-space: nowrap;
  }

  .now-content-col {
    min-width: 0;
  }

  /* ── Markdown Content Styling ── */
  .now-log-content :global(ul) {
    margin: 0;
    padding-left: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .now-log-content :global(li) {
    line-height: var(--leading-normal);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .now-log-content :global(a) {
    color: var(--text-muted);
    text-decoration: underline;
    text-decoration-color: color-mix(
      in srgb,
      var(--border) 50%,
      var(--text-muted)
    );
    text-underline-offset: 3px;
    transition:
      color var(--transition-fast),
      text-decoration-color var(--transition-fast);
  }

  .now-log-content :global(a:hover) {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  .now-log-content :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  .now-log-content :global(em) {
    font-style: italic;
  }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .now-row {
      padding: var(--space-sm) 12px;
      gap: var(--space-xs);
    }

    .now-month {
      font-size: var(--text-sm);
    }
  }
</style>
